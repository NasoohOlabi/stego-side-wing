GOOGLE_API_KEY=
GOOGLE_CSE_ID=
LM_STUDIO_URL=https://approx-chocolate-earth-federation.trycloudflare.com/
LM_STUDIO_API_TOKEN=lm-studio

# Workflow LLM: Google AI Studio (default) or local LM Studio
WORKFLOW_LLM_BACKEND=ai_studio
# Generative Language API keys (comma-separated); try order: GOOGLE_PALM_API_KEY, then this, then GOOGLE_AI_API_KEY
GOOGLE_AI_API_KEYS=
# API key from https://aistudio.google.com/ (or legacy GOOGLE_PALM_API_KEY); may be comma-separated list
GOOGLE_AI_API_KEY=
GOOGLE_AI_STUDIO_MODEL=gemma-4-26b-a4b-it
# GOOGLE_PALM_API_KEY=
# WORKFLOW_LLM_BACKEND=lm_studio

# Workflow capacity profile: low | mid | high
WORKFLOW_CAPACITY_PROFILE=mid
# Optional per-stage overrides (non-negative integers; 0 disables that source/cap)
# WORKFLOW_RESEARCH_MAX_TERMS=8
# WORKFLOW_RESEARCH_MAX_SELECTED_URLS=24
# WORKFLOW_RESEARCH_FETCH_TIMEOUT_SEC=180
# WORKFLOW_RESEARCH_FETCH_RETRIES=1
# WORKFLOW_RESEARCH_FETCH_CONCURRENCY=3
# WORKFLOW_DICTIONARY_MAX_SEARCH_RESULTS=24
# WORKFLOW_DICTIONARY_MAX_COMMENTS=32
# WORKFLOW_ANGLES_MAX_INPUT_BLOCKS=48
# WORKFLOW_ANGLES_MAX_OUTPUT=16

# Optional: URL fetch tuning (analysis / crawl4ai pipelines)
# WORKFLOW_URL_FETCH_HTTP_FIRST=1
