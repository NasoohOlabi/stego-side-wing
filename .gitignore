# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
# Run artifacts and datasets are JSON, so JSON is ignored by default. Checked-in
# configuration and test fixtures must be un-ignored by directory -- an allowlist of
# individual filenames silently drops any new file (that is how
# config/pareto_variants.json ended up untracked while the code required it).
*.json
!config/**/*.json
!src/tests/**/*.json
!.vscode/*.json
*.csv
*.tsv
*.db
*.sqlite*
*.parquet
*.feather
*.pkl
*.pickle
*.npy
*.npz

# Virtual environments
.venv
cache-directory
datasets*
output-results
_cache-directory
.env
kv_store*
prompts.log
logs
debug-*.log


tmp_*
metrics
.tmp

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local pytest/audit scratch paths
.pytest-tmp/
audit_pytest_tmp/
luna_pytest_temp_*/
pytest_tmp*/
test_tmp*/
tmp/pytest-*/

# dev runs and download logs
pid.log
qwen_zlg_download.err.log
qwen_zlg_download.log

